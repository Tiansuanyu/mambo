/ {
    chassis: chassis {
        compatible = "ares,chassis";
        status = "okay";
        
        /* 尺寸修正：长587.5mm(半长294)，宽656.3mm(半宽328) */
        wheels = <&steerwheel1   294  (-328)>,  /* 左前 (Wheel 1) */
                 <&steerwheel2 (-294) (-328)>,  /* 右前 (Wheel 2) */
                 <&steerwheel3   294    328>,  /* 左后 (Wheel 3) */
                 <&steerwheel4 (-294)   328>;  /* 右后 (Wheel 4) */
                 
        angle-pid = <&chassis_roll_angle_pid>;
        max_linear_accel = "6.4";
        max_gyro = "20";
        track_angle;
    };

    steerwheel {
        steerwheel1: steerwheel1 {
            #wheel-cells = <2>;
            compatible = "ares,steerwheel";
            status = "okay";
            steer-motor = <&motor_steer0>;
            wheel-motor = <&motor_wheel0>;
            wheel-radius = "0.0555";
            angle-offset = "120.31";
        };

        steerwheel2: steerwheel2 {
            #wheel-cells = <2>;
            compatible = "ares,steerwheel";
            status = "okay";
            steer-motor = <&motor_steer1>;
            wheel-motor = <&motor_wheel1>;
            wheel-radius = "0.0555";
            angle-offset = "250";
        };

        steerwheel3: steerwheel3 {
            #wheel-cells = <2>;
            compatible = "ares,steerwheel";
            status = "okay";
            steer-motor = <&motor_steer2>;
            wheel-motor = <&motor_wheel2>;
            wheel-radius = "0.0555";
            angle-offset = "185";
        };

        steerwheel4: steerwheel4 {
            #wheel-cells = <2>;
            compatible = "ares,steerwheel";
            status = "okay";
            steer-motor = <&motor_steer3>;
            wheel-motor = <&motor_wheel3>;
            wheel-radius = "0.0555";
            angle-offset = "180";
        };
    };

    rm_motor {
        /* can1 上的电机 (ID: 1, 2, 3, 6) */
        motor_wheel0: motor_wheel0{
            compatible = "dji,motor";
            is_m3508;
            id = <1>;
            rx_id = <0x201>;
            tx_id = <0x200>;
            gear_ratio = "15.7647";
            status = "okay";
            can_channel = <&can1>;
            controllers = <&wheel_angle_pid &wheel_speed_pid>;
            capabilities = "angle", "speed";
        };

        motor_wheel2: motor_wheel2{
            compatible = "dji,motor";
            is_m3508;
            id = <2>;
            rx_id = <0x202>;
            tx_id = <0x200>;
            gear_ratio = "15.7647";
            status = "okay";
            can_channel = <&can1>;
            controllers = <&wheel_angle_pid &wheel_speed_pid>;
            capabilities = "angle", "speed";
        };

        motor_steer0: motor_steer0{
            compatible = "dji,motor";
            is_gm6020;
            minor_arc; 
            id = <3>;
            rx_id = <0x207>;
            tx_id = <0x1FF>;
            gear_ratio = "1.0";
            status = "okay";
            can_channel = <&can1>;
            controllers = <&steer_angle_pid &steer_speed_pid>;
            capabilities = "angle", "speed";
        };

        motor_steer2: motor_steer2{
            compatible = "dji,motor";
            is_gm6020;
            minor_arc; 
            id = <6>;
            rx_id = <0x20A>;
            tx_id = <0x2FF>;
            gear_ratio = "1.0";
            status = "okay";
            can_channel = <&can1>;
            controllers = <&steer_angle_pid &steer_speed_pid>;
            capabilities = "angle", "speed";
        };

        /* can2 上的电机 (ID: 4, 3, 2, 1) */
        motor_wheel1: motor_wheel1{
            compatible = "dji,motor";
            is_m3508;
            id = <4>;
            rx_id = <0x204>;
            tx_id = <0x200>;
            gear_ratio = "15.7647";
            status = "okay";
            can_channel = <&can2>;
            controllers = <&wheel_angle_pid &wheel_speed_pid>;
            capabilities = "angle", "speed";
        };

        motor_wheel3: motor_wheel3{
            compatible = "dji,motor";
            is_m3508;
            id = <3>;
            rx_id = <0x203>;
            tx_id = <0x200>;
            gear_ratio = "15.7647";
            status = "okay";
            can_channel = <&can2>;
            controllers = <&wheel_angle_pid &wheel_speed_pid>;
            capabilities = "angle", "speed";
        };

        motor_steer1: motor_steer1{
            compatible = "dji,motor";
            is_gm6020;
            minor_arc; 
            id = <2>;
            rx_id = <0x206>;
            tx_id = <0x1FF>;
            gear_ratio = "1.0";
            status = "okay";
            can_channel = <&can2>;
            controllers = <&steer_angle_pid &steer_speed_pid>;
            capabilities = "angle", "speed";
        };

        motor_steer3: motor_steer3{
            compatible = "dji,motor";
            is_gm6020;
            minor_arc; 
            id = <1>;
            rx_id = <0x205>;
            tx_id = <0x1FF>;
            gear_ratio = "1.0";
            status = "okay";
            can_channel = <&can2>;
            controllers = <&steer_angle_pid &steer_speed_pid>;
            capabilities = "angle", "speed";
        };
    };

    pid {
		wheel_speed_pid: wheel_speed_pid {
			#controller-cells = <0>;
			compatible = "pid,single";
			k_p = "0.12";
			k_d = "0.2";
			detri_lpf = "0.85";
			out_max = "4";
		};

		wheel_angle_pid: wheel_angle_pid {
			#controller-cells = <0>;
			compatible = "pid,single";
			k_p = "3.7";
			detri_lpf = "0.85";
		};

		steer_speed_pid: steer_speed_pid {
			#controller-cells = <0>;
			compatible = "pid,single";
			k_p = "0.0125";
			k_d = "0.003";
			detri_lpf = "0.995";
		};

		steer_angle_pid: steer_angle_pid {
			#controller-cells = <0>;
			compatible = "pid,single";
			k_p = "8.55";
			k_i = "0.00000000001";
			i_max = "56";
			detri_lpf = "0.95";
		};

		chassis_roll_angle_pid: chassis_roll_angle_pid {
			#controller-cells = <0>;
			compatible = "pid,single";
			k_p = "0.09";
			k_d = "0.27";
		};
	};

    sbus0: sbus0 {
        compatible = "ares,sbus";
        status = "okay";
    };
};
